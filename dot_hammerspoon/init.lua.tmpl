hs.console.clearConsole()

local control_escape = require("control_escape")
control_escape:init()
control_escape:start()

local window_keyboard = require("window_keyboard")
window_keyboard:init({
  move_mods = { "ctrl", "cmd" },
  resize_mods = { "ctrl", "alt" }
})
window_keyboard:start()

local window_mouse = require("window_mouse")
window_mouse:init({
  move_mods = { "ctrl", "cmd" },
  resize_mods = { "ctrl", "alt" },
  resize_only_bottom_right = true
})
window_mouse:start()

hs.loadSpoon("URLDispatcher")
spoon.URLDispatcher.set_system_handler = false -- set Hammerspoon as default browser by hand instead
spoon.URLDispatcher.default_handler = "{{ if .work }}app.zen-browser.zen{{ else }}com.apple.Safari{{ end }}"
spoon.URLDispatcher.url_patterns = {
{{- if .work }}
  { "https?://meet%.google%.com", "au.id.riley.crossbench.siteapp.38184FF6-A13E-4EC2-AC57-4288E9970037" },
{{- end }}
}
spoon.URLDispatcher:start()

hs.notify.show("Welcome to Hammerspoon", "Have fun!", "")
