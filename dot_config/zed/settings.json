// Zed settings. See https://zed.dev/docs/configuring-zed.

{
  // EDITOR SETTINGS

  // Appearance
  "theme": {
    "light": "Catppuccin Latte - No Italics",
    "dark": "Catppuccin Mocha - No Italics",
  },
  "icon_theme": {
    "light": "Catppuccin Latte",
    "dark": "Catppuccin Mocha",
  },
  "ui_font_family": "iA Writer Quattro V",
  "ui_font_size": 15,
  "buffer_font_size": 14,
  "buffer_font_family": "JetBrains Mono NL",
  "agent_ui_font_size": 18,
  "agent_buffer_font_size": 14,

  // Panels
  "project_panel": {
    "dock": "left",
    "indent_size": 10, // Slightly less than default, for more compact nesting.
    "auto_fold_dirs": true,
    "indent_guides": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },

  // Make the terminal match my Mac terminal.
  "terminal": {
    "blinking": "off",
    "line_height": "standard",
    "font_size": 15,
    "font_weight": 300,
  },

  // EDITOR BEHAVIOR

  "cli_default_open_behavior": "new_window",
  // I tend to use the multi-buffer to jump directly to the relevant files.
  "double_click_in_multibuffer": "open",

  // LANGUAGE SETTINGS

  "tab_size": 2,
  "languages": {
    "HTML": {
      "preferred_line_length": 120,
      "wrap_guides": [120],
    },
    "Markdown": {
      "preferred_line_length": 100,
      "soft_wrap": "bounded",
      "show_edit_predictions": false,
    },
    "Ruby": {
      "tab_size": 2,
      "preferred_line_length": 100,
      "wrap_guides": [100],
      // Use ruby-lsp, not the Ruby extension's default of solargraph.
      "language_servers": ["ruby-lsp", "!solargraph"],
      "use_on_type_format": false, // see https://github.com/zed-industries/zed/issues/16617
    },
    "YAML": {
      "preferred_line_length": 100,
      "wrap_guides": [100],
    },
  },

  // AI FEATURES

  "agent": {
    "sidebar_side": "right",
    "dock": "right",
    "default_profile": "write",
    "default_model": {
      "provider": "copilot_chat",
      "model": "claude-sonnet-4.5",
    },
    "use_modifier_to_send": true,
    // Agent feedback buttons send the thread to Zed. Don't ever want that.
    "enable_feedback": false,
  },
  "agent_servers": {
    "claude-acp": {
      "type": "registry"
    }
  },
  "edit_predictions": {
    "provider": "none"
  },

  // DISABLE FEATURES

  "collaboration_panel": {
    "dock": "left",
    "button": false,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
}
