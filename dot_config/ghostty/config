theme = light:Adwaita, dark:Catppuccin Mocha

font-family = JetBrains Mono NL
font-size = 15

shell-integration-features = no-cursor
cursor-style = block
cursor-style-blink = false

window-padding-x = 6

working-directory = home
window-inherit-working-directory = true

# Keybindings

# Enter new line without executing command
keybind = shift+enter=text:\n

# Allow option+backspace to properly delete previous words in fish. Required as of v1.2.0.
#
# See https://github.com/ghostty-org/ghostty/discussions/8677.
#
# (If needed, an alternative is to set `keybind = alt+backspace=text:\x1b\x7f`).
macos-option-as-alt = true
